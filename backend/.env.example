# AIDeepresearch 后端环境变量示例
# cp .env.example .env 后填入你的密钥

# -----------------------------------------------------------------------------
# LLM（OpenAI 兼容 API）
# -----------------------------------------------------------------------------
LLM_PROVIDER=custom
LLM_MODEL_ID=deepseek-chat
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1

LLM_TIMEOUT=120
LLM_MAX_TOKENS=8192
LLM_MAX_RETRIES=4

# -----------------------------------------------------------------------------
# 网页搜索
# -----------------------------------------------------------------------------
SEARCH_API=local
# SEARCH_API=baidu
# BAIDU_ACCESS_TOKEN=your-baidu-qianfan-token
# SEARCH_API=tavily
# TAVILY_API_KEY=tvly-xxxxx
# PERPLEXITY_API_KEY=pplx-xxxxx
# SEARXNG_URL=http://localhost:8888

# -----------------------------------------------------------------------------
# 调查流程
# -----------------------------------------------------------------------------
MAX_WEB_RESEARCH_LOOPS=3
FETCH_FULL_PAGE=True

# -----------------------------------------------------------------------------
# 本地模型（LLM_PROVIDER=ollama 或 lmstudio）
# -----------------------------------------------------------------------------
# LLM_PROVIDER=ollama
# LOCAL_LLM=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_PROVIDER=lmstudio
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# -----------------------------------------------------------------------------
# HTTP 服务
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 摄像头数据源（直读 search 项目 SQLite + 快照图片）
# -----------------------------------------------------------------------------
# CAMERA_DB_PATH=/path/to/search/snapshot_data/counts.db
# CAMERA_SNAPSHOT_SRC=/path/to/search/snapshot_data
# CAMERA_SNAPSHOT_LOCAL=./snapshot_data
