# AIDeepresearch 后端环境变量示例
# cp .env.example .env 后填入你的密钥

# -----------------------------------------------------------------------------
# LLM（OpenAI 兼容 API）
# -----------------------------------------------------------------------------
LLM_API_KEY=sk-d94e6a5dbd524ef3b936e3e2a5a48bc7
LLM_PROVIDER=custom
LLM_MODEL_ID=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com/v1

LLM_TIMEOUT=120
LLM_MAX_TOKENS=8192
LLM_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# 网页搜索
# -----------------------------------------------------------------------------
SEARCH_API=duckduckgo
# SEARCH_API=tavily
# TAVILY_API_KEY=tvly-xxxxx
# PERPLEXITY_API_KEY=pplx-xxxxx
# SEARXNG_URL=http://localhost:8888

# -----------------------------------------------------------------------------
# 研究流程
# -----------------------------------------------------------------------------
MAX_WEB_RESEARCH_LOOPS=3
FETCH_FULL_PAGE=True

# -----------------------------------------------------------------------------
# 本地模型（LLM_PROVIDER=ollama 或 lmstudio）
# -----------------------------------------------------------------------------
# LLM_PROVIDER=ollama
# LOCAL_LLM=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_PROVIDER=lmstudio
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# -----------------------------------------------------------------------------
# HTTP 服务
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 贷后监管系统 (Post-loan Supervision)
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./postloan.db
SCHEDULER_ENABLED=false
WEEKLY_REPORT_CRON=0 17 * * 5
POSTLOAN_CONFIG_DIR=./src/postloan/config_files
REPORT_OUTPUT_DIR=./reports

